# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (Railway Postgres en prod)
DATABASE_URL=postgresql://user:password@localhost:5432/writer_cms

# Session (min 32 chars)
SESSION_SECRET=change-me-min-32-chars-random-string-here

# Admin seed (solo primera migración/seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@tudominio.com
ADMIN_NOTIFICATION_EMAIL=escritor@tudominio.com

# Trust proxy (Railway/Render = true)
TRUST_PROXY=false
